      "<div class=\"mw-indicators\">\n",
      "</div>\n",
      "<div class=\"noprint\" id=\"siteSub\">From Wikipedia, the free encyclopedia</div>\n",
      "</div>\n",
      "<div id=\"contentSub\"><div id=\"mw-content-subtitle\"></div></div>\n",
      "<div class=\"mw-body-content\" id=\"mw-content-text\"><div class=\"mw-subjectpageheader\">\n",
      "</div><div class=\"mw-content-ltr mw-parser-output\" data-mw-html-version=\"2.8.0\" data-mw-parsoid-version=\"0.24.0.0-alpha18\" dir=\"ltr\" lang=\"en\"><section data-mw-section-id=\"0\" id=\"mwAQ\"><p id=\"mwAg\"><span about=\"#mwt1\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Short description\",\"href\":\"./Template:Short_description\"},\"params\":{\"1\":{\"wt\":\"None\"}},\"i\":0}}]}' id=\"mwAw\" typeof=\"mw:Nowiki mw:Transclusion\"></span><link about=\"#mwt1\" href=\"./Category:Articles_with_short_description\" rel=\"mw:PageProp/Category\"/><link about=\"#mwt1\" href=\"./Category:Short_description_is_different_from_Wikidata\" id=\"mwBA\" rel=\"mw:PageProp/Category\"/>\n",
      "Following is a list of largest <a href=\"https://en.wikipedia.org/wiki/Company\" id=\"mwBQ\" rel=\"mw:WikiLink\" title=\"Company\">companies</a> in Pakistan:</p>\n",
      "</section><section aria-labelledby=\"Conglomerates\" data-mw-section-id=\"1\" id=\"mwBg\"><div class=\"mw-heading mw-heading2\"><h2 id=\"Conglomerates\">Conglomerates</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=List_of_largest_companies_in_Pakistan&amp;action=edit&amp;section=1\" title=\"Edit section: Conglomerates\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n",
      "<table class=\"wikitable sortable\" id=\"mwBw\">\n",
      "<tbody id=\"mwCA\"><tr id=\"mwCQ\">\n",
      "<th id=\"mwCg\">Group name</th><th id=\"mwCw\">Headquarters</th><th id=\"mwDA\">Publicly listed companies</th><th id=\"mwDQ\">Reference(s)</th></tr>\n",
      "<tr id=\"mwDg\">\n",
