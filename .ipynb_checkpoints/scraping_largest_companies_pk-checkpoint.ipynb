    "# Clean headers - drop 'Reference(s)'\n",
    "title_headers_2 = title_headers_2[:-1]\n",
    "\n",
    "# Collect all cleaned rows into one list\n",
    "clean_rows_2 = []\n",
    "for row in data_2[1:]:   # [1:] skips the header row\n",
    "    row_data_2 = row.find_all('td')\n",
    "    individual_row_data = [data.text.strip().replace('\\xa0', ' ') for data in row_data_2]\n",
    "    individual_row_data = individual_row_data[:-1]\n",
    "    clean_rows_2.append(individual_row_data)\n",
    "\n",
    "# Build the DataFrame\n",
    "df_2 = pd.DataFrame(clean_rows_2, columns=title_headers_2)\n",
    "df_2\n",
